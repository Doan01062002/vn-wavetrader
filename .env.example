# API Key cho Google Gemini LLM
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình Telegram Bot để nhận báo cáo hàng ngày
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

DATABASE_URL=postgresql://postgres:your_supabase_password_here@db.your_project_id_here.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your_project_id_here.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
